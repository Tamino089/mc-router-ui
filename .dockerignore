# Files that must never enter the build context.
# The image only needs app/, requirements.txt and supervisord.conf.

# Python bytecode and build output.
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Virtual environments. Excluding these keeps the context small; without this
# the whole venv is uploaded on every build.
.venv/
venv/
env/

# Test and tooling caches.
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# Tests and development tooling are not part of the runtime image.
tests/
requirements-dev.txt
pyproject.toml
.editorconfig

# Secrets and local environment.
.env
.env.*
!.env.example
*.env

# Version control and CI.
.git/
.gitignore
.gitattributes
.github/

# Documentation and packaging metadata.
*.md
*.xml
docs/
scripts/

# Editor and OS noise.
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# Logs and local databases.
*.log
*.db
*.db-wal
*.db-shm
