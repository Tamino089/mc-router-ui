# MC Router UI configuration.
# Copy to .env and fill in. Never commit the real .env.

# Admin login.
# ADMIN_PASSWORD bootstraps the admin account on first start only and must be at
# least 12 characters. Leaving it as 'changeme' logs a warning and raises a
# banner in the UI until the password is changed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional. When blank, a key is generated and persisted to the database.
SECRET_KEY=

# Ports.
MC_PORT=25565                   # Minecraft ingress (exposed externally)
API_PORT=8080                   # mc-router REST API (internal, not exposed)
UI_PORT=8090                    # Host port mapped to container port 8000

# mc-router API. Defaults to the router started alongside the UI.
MC_ROUTER_API=http://localhost:8080

# Database.
DB_PATH=/data/mcrouter-ui.db

# Session cookies.
# Set SESSION_HTTPS_ONLY=true when the UI is served through a TLS-terminating
# proxy; it also enables HSTS. Leaving it false keeps plain-HTTP LAN access working.
SESSION_HTTPS_ONLY=false
SESSION_SAME_SITE=lax
SESSION_MAX_AGE=1209600         # 14 days, in seconds

# Cloudflare DDNS (optional).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=           # used when ZONE_ID is omitted; resolved via the API
DDNS_INTERVAL_SECONDS=300

# Crafty Controller (optional).
CRAFTY_URL=
CRAFTY_API_KEY=
CRAFTY_SERVERS_DIR=
CRAFTY_INSECURE_SKIP_VERIFY=    # true only for a trusted LAN host with a self-signed certificate
CRAFTY_CONTAINER_HOST=          # hostname or IP used for TCP checks against Crafty servers
SERVER_PROPERTIES_PATH=         # exact path to server.properties, overriding auto-detection

# Health worker.
HEALTH_CHECK_INTERVAL=30
HEALTH_HISTORY_RETENTION_HOURS=24

# Docker discovery (optional).
DOCKER_SOCKET=/var/run/docker.sock

# Runtime.
LOG_LEVEL=INFO                  # CRITICAL, ERROR, WARNING, INFO or DEBUG
MIN_PASSWORD_LENGTH=12
