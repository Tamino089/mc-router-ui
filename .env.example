# ═══════════════════════════════════════════════════════════
#  MC Router UI — example configuration
#  Copy to `.env` and fill in. Never commit the real `.env`.
# ═══════════════════════════════════════════════════════════

# ── Admin Login ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                  # MANDATORY: use ≥12 chars; never 'changeme' in prod
SECRET_KEY=                     # Optional; auto-generated and persisted to DB if blank

# ── Ports ───────────────────────────────────────────────────
MC_PORT=25565                   # Minecraft ingress (exposed externally)
API_PORT=8080                   # mc-router REST API (internal, not exposed)
UI_PORT=8090                    # Web UI host port → container 8000

# ── Database ────────────────────────────────────────────────
DB_PATH=/data/mcrouter-ui.db

# ── Cloudflare DDNS (optional) ─────────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ZONE_NAME=            # used if ZONE_ID omitted; resolved via API
DDNS_INTERVAL_SECONDS=300

# ── Crafty Controller (optional) ───────────────────────────
CRAFTY_URL=
CRAFTY_API_KEY=
CRAFTY_SERVERS_DIR=
CRAFTY_TLS_VERIFY=true

# ── Health worker ───────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30
HEALTH_HISTORY_RETENTION_HOURS=24

# ── Runtime ─────────────────────────────────────────────────
LOG_LEVEL=INFO
